# Copy to .env and set strong passwords before starting Postgres.
# Never commit .env.

# PostgreSQL
POSTGRES_USER=pii_app
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=pii_research
POSTGRES_PORT=5432

# Used by migrate scripts (defaults match compose service name)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_URL=postgresql://pii_app:change_me_strong_password@localhost:5432/pii_research

# Optional: separate n8n DB on same server later (do not reuse pii_research)
# N8N_POSTGRES_DB=n8n
