# Copy to .env and set strong passwords before starting Postgres.
# Never commit .env.

# PostgreSQL
POSTGRES_USER=pii_app
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=pii_research
# Host publish port. Use 5433 (or another free port) if 5432 is already taken.
POSTGRES_PORT=5433

# Host-side connection settings (apps on the host, not the migrate container)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_URL=postgresql://pii_app:change_me_strong_password@localhost:5433/pii_research

# Optional: separate n8n DB on same server later (do not reuse pii_research)
# N8N_POSTGRES_DB=n8n

# Webhook caller auth (optional, for local curl/tests only)
# Canonical secret lives in n8n credential: PII Webhook Header Auth
PII_WEBHOOK_HEADER_NAME=X-PII-API-Key
# PII_WEBHOOK_HEADER_VALUE=never_commit_this
